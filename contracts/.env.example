# Aumo contracts — deploy config. Copy to .env.local (gitignored) and fill in.
# NEVER commit real keys. .env / .env.local are gitignored.

# --- X Layer testnet ---
XLAYER_TESTNET_RPC=https://testrpc.xlayer.tech
# your deploy wallet's PRIVATE KEY (testnet only). Stays local, never shared.
PRIVATE_KEY=0xYOUR_TESTNET_PRIVATE_KEY

# --- deploy params ---
# USDT0 (base asset) address on the target chain
ASSET=0x0000000000000000000000000000000000000000
# vault owner / initial agent (your deploy wallet address)
VAULT_OWNER=0x0000000000000000000000000000000000000000

# --- initial policy (USDT0 has 6 decimals; 1 USDT0 = 1000000) ---
MAX_MOVE=100000000        # 100 USDT0 max per allocate
PER_VENUE_CAP=500000000   # 500 USDT0 max per venue
MAX_TOTAL=1000000000      # 1000 USDT0 max deployed overall
