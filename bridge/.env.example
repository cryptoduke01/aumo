# Source chain to bridge FROM: ethereum | arbitrum | optimism | polygon
SOURCE_CHAIN=arbitrum

# Optional RPC override for the source chain (defaults to a public RPC).
SOURCE_RPC=

# Where the bridged USDT0 should land on X Layer. Defaults to the vault owner.
RECIPIENT=0x197ED5B2313fA482EC271861360E839A8eF75731

# Slippage tolerance in basis points for the minimum received (USDT0 OFT is 1:1, so 0 is fine).
SLIPPAGE_BPS=0

# --- Sending (real funds) ---
# Only needed for `npm run send`. NEVER commit a funded key.
PRIVATE_KEY=
# Explicit safety switch: `send` refuses unless SEND=1.
SEND=0
