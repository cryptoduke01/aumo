{
  "name": "@aumo/mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server that lets any AI agent use Aumo as its treasury layer: read the agent's state and decisions, check positions, and prepare unsigned deposit and withdraw transactions on X Layer.",
  "bin": {
    "aumo-mcp": "dist/index.js"
  },
  "scripts": {
    "start": "tsx src/index.ts",
    "start:http": "tsx src/index.ts --http --port 3333",
    "build": "tsc -p tsconfig.build.json",
    "test": "node --import tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "viem": "^2.55.11",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2"
  }
}
