{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm ci && npm run build"
  },
  "deploy": {
    "startCommand": "node dist/index.js --http --host 0.0.0.0",
    "healthcheckPath": "/health",
    "restartPolicyType": "ON_FAILURE"
  }
}
