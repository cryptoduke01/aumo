# --- Chain ---
CHAIN_ID=1952
CHAIN_NAME=X Layer Testnet
RPC_URL=https://testrpc.xlayer.tech

# --- Vault (X Layer testnet deployment) ---
VAULT_ADDRESS=0x52Fc89beD432e068a0a837065fbCFaDb3573A55e

# Which venue metadata feed to load (config/venues.<file>.json)
VENUES_FILE=testnet

# --- Agent key ---
# The address set as agent() on the vault. TESTNET THROWAWAY ONLY. Never a mainnet key.
AGENT_PRIVATE_KEY=

# --- Reasoning layer (optional) ---
# Without a key, the agent runs on the deterministic risk engine alone and still
# produces a full plan + rationale. With a key, the LLM adds a regime read and may
# only TIGHTEN the plan (never loosen a guardrail or add a venue).
ANTHROPIC_API_KEY=
AUMO_MODEL=claude-sonnet-4-5

# --- Policy / behaviour ---
# Risk appetite ceiling: low | moderate | elevated
RISK_APPETITE=moderate
# Max share of the portfolio the agent will concentrate in a single venue (0..1)
MAX_CONCENTRATION=0.6
# Seconds between ticks in `loop` mode
LOOP_INTERVAL_SECONDS=900

# --- Receipts (the off-chain proof trail) ---
# Where decision receipts are written/read. Defaults to ./receipts inside the repo, which is WIPED on
# every redeploy in an ephemeral container (e.g. Railway with no volume). In production, mount a
# persistent volume and point this at it so the proof trail survives restarts, e.g. RECEIPTS_DIR=/data
# RECEIPTS_DIR=/data

# --- Signer: Turnkey (preferred on mainnet) ---
# When all four TURNKEY_* below are set, the agent signs via Turnkey and AGENT_PRIVATE_KEY is ignored.
# The signing key lives in Turnkey; the agent holds only an API key that requests signatures (ideally
# restricted by a Turnkey policy to the pool contract). TURNKEY_SIGN_WITH must equal on-chain agent().
# Create the wallet with `tsx scripts/turnkey-create-wallet.ts`; verify with `scripts/turnkey-verify.ts`.
# TURNKEY_BASE_URL=https://api.turnkey.com
# TURNKEY_ORGANIZATION_ID=
# TURNKEY_API_PUBLIC_KEY=
# TURNKEY_API_PRIVATE_KEY=
# TURNKEY_SIGN_WITH=0x...

# --- Safety switch ---
# 0 = dry-run (sense, score, reason, plan — no transactions)
# 1 = live (send allocate/deallocate transactions within on-chain caps)
EXECUTE=0

# --- Tokenized stocks: Chainlink Data Streams oracle updater (MAINNET) ---
# The agent is the ChainlinkStreamsEquityOracle `updater`: each cycle it fetches a signed Data Streams
# report and submits it via updateReport (`npm run equity-oracle-update`). Get credentials from the
# Chainlink Data Streams self-service portal. NEVER commit real values or paste the HMAC secret into
# chat — set them only in your local .env (gitignored) or Railway variables. Regenerate the secret if
# it was ever shared.
# STREAMS_API_URL=https://api.dataengine.chain.link      # testnet: https://api.testnet-dataengine.chain.link
# STREAMS_API_KEY=          # Data Streams Username / API key (the Authorization header value)
# STREAMS_API_SECRET=       # HMAC secret used to sign requests
# EQUITY_STREAMS_ORACLE=    # deployed ChainlinkStreamsEquityOracle address
# STREAMS_FEED_IDS=         # comma-separated Data Streams feed IDs, e.g. 0xabc...,0xdef...

# --- Tokenized stocks: self-hosted oracle updater (MAINNET, v1 while Data Streams/Supra equities are gated) ---
# The agent is the SelfHostedEquityOracle `updater`: each cycle it pulls a quote per xStock from Finnhub,
# resolves the US market session, and submits the batch via submitPrices (`npm run equity-oracle-update-self`).
# This makes Aumo the price source (disclosed to depositors); consumers read the oracle-agnostic
# IEquityOracle, so migrating to Data Streams/Supra later is a single setOracle on the adapter. Only quotes
# newer than what is stored are submitted, so a closed market costs no transaction. NEVER commit the key.
# FINNHUB_API_KEY=          # Finnhub market-data key (free tier covers real-time US large-cap quotes)
# FINNHUB_API_URL=https://finnhub.io   # override only for a proxy/self-host
# SELF_HOSTED_EQUITY_ORACLE=  # deployed SelfHostedEquityOracle address
# EQUITY_SYMBOLS=NVDA,TSLA,AAPL,MSFT,AMZN,META,GOOGL,COIN   # US tickers, each registered on the oracle
